{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductStockDebitedV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "productId": {
      "type": "integer",
      "format": "int64"
    },
    "newStock": {
      "type": "integer",
      "format": "int32"
    },
    "debitedQuantity": {
      "type": "integer",
      "format": "int32"
    }
  },
  "required": ["messageId", "created", "productId", "newStock", "debitedQuantity"]
}
