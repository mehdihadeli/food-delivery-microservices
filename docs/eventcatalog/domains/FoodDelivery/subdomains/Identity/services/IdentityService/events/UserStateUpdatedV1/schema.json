{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserStateUpdatedV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "oldUserState": {
      "type": "string",
      "enum": ["Active", "Suspended", "Deactivated"]
    },
    "newUserState": {
      "type": "string",
      "enum": ["Active", "Suspended", "Deactivated"]
    }
  },
  "required": ["messageId", "created", "userId", "oldUserState", "newUserState"]
}
